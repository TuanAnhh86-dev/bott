# ============================================================
# EM MÌ — AUTONOMOUS AI CREATOR BUSINESS AGENT
# Biến môi trường mẫu — copy thành .env.local và điền thông tin thực
# ============================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Payout owner lock: set to the UUID of one verified admin profile.
PAYOUT_OWNER_USER_ID=
# Base64-encoded 32-byte key used to encrypt payout account details.
PAYOUT_DATA_ENCRYPTION_KEY=
# 6-digit Payout Security PIN required for executing real bank withdrawals
PAYOUT_SECURITY_PIN=888888
PAYOUT_DAILY_LIMIT_VND=10000000
PAYOUT_MIN_WITHDRAWAL_VND=50000

# AI Provider Configuration (Google Gemini)
# Runtime-added keys are memory-only; use server environment variables for persistence.
AI_API_KEY=
AI_API_KEYS=

# Model Routing Configuration
AI_MODEL_CHEAP=gemini-3.6-flash
AI_MODEL_STANDARD=gemini-3.6-flash
AI_MODEL_COMPLEX=gemini-3.6-flash

# Emergency Stop test override; production reads the database setting.
AI_EMERGENCY_STOP_ENABLED=false
